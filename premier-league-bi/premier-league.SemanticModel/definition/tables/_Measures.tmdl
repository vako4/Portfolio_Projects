table _Measures
	lineageTag: 655e4ea2-a48a-406e-96d0-ead043daa80f

	measure 'Total Points' = SUM(Team_Matches[Points])
		formatString: 0
		lineageTag: a29fbc78-3953-4ca5-9db5-ab19032998eb

	measure 'Total Goals For' = SUM(Team_Matches[GoalsFor])
		formatString: 0
		lineageTag: 5e563ad6-e716-4d78-8706-22ed4e13e484

	measure 'Total Goals Against' = SUM(Team_Matches[GoalsAgainst])
		formatString: 0
		lineageTag: b1b43506-70fd-489d-9611-a4659a740047

	measure 'Matches Played' = COUNTROWS(Team_Matches)
		formatString: 0
		lineageTag: f5cf69a1-634b-47bf-83a4-4b672bd2e2b4

	measure Wins = CALCULATE(COUNTROWS(Team_Matches), Team_Matches[Result] = "W")
		formatString: 0
		lineageTag: 8c68f6c5-0d9f-42e7-a9e7-03b4ea71bd82

	measure 'Goal Difference' = [Total Goals For] - [Total Goals Against]
		formatString: 0
		lineageTag: 90449f4b-6d38-49ac-9f3c-5d43f52388d8

	measure 'Points Per Game' = DIVIDE([Total Points], [Matches Played])
		lineageTag: d65779a4-4541-4b2b-b3e1-02c6dacf3eff

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Home Points' = CALCULATE([Total Points], Team_Matches[IsHome] = TRUE())
		formatString: 0
		lineageTag: ec4abed7-c1d5-4f59-ab69-08c8293898ef

	measure 'Away Points' = CALCULATE([Total Points], Team_Matches[IsHome] = FALSE())
		formatString: 0
		lineageTag: 88c71ea4-6cdc-4242-a3a6-fc5a5f02155a

	measure 'Home Advantage' = [Home Points Per Game] - [Away Points Per Game]
		lineageTag: c9932db9-0f14-45f9-ba34-233652767229

	measure 'Away Points Per Game' =
			
			DIVIDE(
			    [Away Points],
			    CALCULATE([Matches Played], Team_Matches[IsHome] = FALSE())
			)
		lineageTag: e0ee7075-0805-442f-ac4d-56ab77ca089c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Home Points Per Game' =
			
			DIVIDE(
			    [Home Points],
			    CALCULATE([Matches Played], Team_Matches[IsHome] = TRUE())
			)
		lineageTag: cf6d0882-435c-4047-945d-0f7c775f6ca7

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Rolling Form (Last 5)' =
			
			VAR CurrentMatchNum = MAX(Team_Matches[Match Number In Season])
			VAR CurrentTeam = MAX(Team_Matches[Team])
			VAR CurrentSeason = MAX(Team_Matches[Season])
			RETURN
			CALCULATE(
			    SUM(Team_Matches[Points]),
			    FILTER(
			        ALL(Team_Matches),
			        Team_Matches[Team] = CurrentTeam
			        && Team_Matches[Season] = CurrentSeason
			        && Team_Matches[Match Number In Season] <= CurrentMatchNum
			        && Team_Matches[Match Number In Season] > CurrentMatchNum - 5
			    )
			)
		formatString: 0
		lineageTag: 5f74a8f3-4b30-49de-acac-3480df1d8e66

	measure 'Total Matches' = COUNTROWS(Matches)
		formatString: 0
		lineageTag: 4648d4c3-98ab-4124-a894-9fed22b3596f

	measure 'Total Goals (League)' = SUM(Matches[FTHG]) + SUM(Matches[FTAG])
		formatString: 0
		lineageTag: 475e30cc-bb9e-4c8a-aab7-b821ae408301

	measure 'Goals Per Match' = DIVIDE([Total Goals (League)], [Total Matches])
		lineageTag: 3a788a69-6d0d-4a9a-8004-da370098b013

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	partition _Measures = m
		mode: import
		source =
				let
				  Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Column1 = _t]),
				    #"Removed Columns" = Table.RemoveColumns(Source,{"Column1"})
				in
				  #"Removed Columns"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

